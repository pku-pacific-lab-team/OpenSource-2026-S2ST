+        if prefix_tokens is not None and start > 0 and beam_size > 1:
+            # The loop below starts at `start` with every beam holding the same
+            # prefix and a cumulative score of 0, so the first search step would
+            # produce beam_size identical copies of the top token and beam search
+            # degenerates to greedy.  Mark beams 1..k-1 as dead so that the first
+            # free step expands from beam 0 only (same as fairseq's step-0 rule).
+            dead = torch.ones(bsz, beam_size, dtype=torch.bool, device=scores.device)
+            dead[:, 0] = False
+            scores.view(bsz, beam_size, -1)[:, :, start - 1][dead] = -math.inf
+
